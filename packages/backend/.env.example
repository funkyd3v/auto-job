NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://autojob:autojob_secret@localhost:5432/autojob?schema=public
REDIS_URL=redis://:autojob_redis_secret@localhost:6379
JWT_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-at-least-16-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=change-me-at-least-32-chars-long
CORS_ORIGIN=http://localhost:5173
# Set to false when serving over plain HTTP (no domain/TLS), else browsers drop the refresh cookie
COOKIE_SECURE=false