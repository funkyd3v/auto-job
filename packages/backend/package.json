    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.31.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "grammy": "^1.35.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.12.0",
