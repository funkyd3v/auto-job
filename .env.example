# --- PostgreSQL ---
POSTGRES_USER=autojob
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=autojob

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_password

# --- Auth secrets (min 16 chars) ---
JWT_SECRET=CHANGE_ME_32_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_32_random_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Config encryption (min 32 chars) ---
ENCRYPTION_KEY=CHANGE_ME_32_random_chars

# --- Dashboard public URL (used as CORS allowlist) ---
DASHBOARD_URL=http://YOUR_VPS_IP:8081

# --- Plain HTTP (no domain): keep false. Set true behind HTTPS/TLS. ---
COOKIE_SECURE=false

# --- Optional: Telegram bot fallback ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Leave empty: nginx proxies /api same-origin to the backend. ---
# VITE_API_URL=